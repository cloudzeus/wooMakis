generator client {
  provider = "prisma-client-js"
}

// Prisma 7 removed `url` from the datasource block. Migrate/CLI reads the
// connection string from prisma.config.ts; the runtime client gets it from the
// PrismaPg adapter in src/lib/prisma.ts. Do not re-add `url` here — it is a
// hard P1012 error, not a warning.
datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  active       Boolean  @default(true)
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  trdrId       String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([roleId])
  @@index([trdrId])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  system      Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

enum SyncDirection {
  PULL
  PUSH
}

enum SyncOutcome {
  SUCCESS
  PARTIAL
  FAILED
}

model Category {
  id             String   @id @default(cuid())
  wooGroupKey    Int      @unique
  parentGroupKey Int?
  menuOrder      Int      @default(0)
  count          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  translations CategoryTranslation[]
  products     ProductCategory[]

  @@index([parentGroupKey])
}

model CategoryTranslation {
  categoryId    String
  locale        String
  wooId         Int       @unique
  wooModifiedAt DateTime?
  wooSnapshot   Json?
  name          String
  slug          String
  description   String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
  @@index([slug])
}

model Product {
  id            String   @id @default(cuid())
  wooGroupKey   Int      @unique
  sku           String?
  type          String
  status        String
  featured      Boolean  @default(false)
  price         Decimal? @db.Decimal(12, 2)
  regularPrice  Decimal? @db.Decimal(12, 2)
  /// Derived locally: Woo's sale_price and on_sale fields cannot be read (see spec §2.1).
  onSale        Boolean  @default(false)
  manageStock   Boolean  @default(false)
  stockQuantity Int?
  stockStatus   String   @default("instock")
  menuOrder     Int      @default(0)
  totalSales    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// The parent's attribute definitions exactly as WooCommerce returns them:
  /// [{id, name, slug, position, visible, variation, options[]}]. Stored as
  /// JSON rather than normalised because the set is per-product, read whole,
  /// and never queried by individual option.
  attributes    Json?

  translations ProductTranslation[]
  variations   ProductVariation[]
  categories   ProductCategory[]
  images       ProductImage[]
  cartLines    CartLine[]
  brands       ProductBrand[]
  orderLines   OrderLine[]

  @@index([type])
  @@index([status])
  @@index([sku])
}

model ProductTranslation {
  productId        String
  locale           String
  /// Null when this language has no WooCommerce post yet — e.g. a translation
  /// created locally by DeepSeek for one of the 20 single-language products.
  /// Publishing it means creating a Polylang post and linking the translation
  /// group, which is a separate operation (phase 4). Postgres permits many
  /// NULLs under a unique index, so this stays unique for real ids.
  wooId            Int?      @unique
  wooModifiedAt    DateTime?
  wooSnapshot      Json?
  name             String
  slug             String
  description      String?
  shortDescription String?
  permalink        String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
  @@index([slug])
}

model ProductVariation {
  id            String   @id @default(cuid())
  productId     String
  wooId         Int      @unique
  sku           String?
  price         Decimal? @db.Decimal(12, 2)
  regularPrice  Decimal? @db.Decimal(12, 2)
  stockQuantity Int?
  stockStatus   String   @default("instock")
  menuOrder     Int      @default(0)
  attributes    Json
  imageId       String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

/// Folders in the media library. Self-referencing so they can nest; deleting a
/// parent cascades to its children, but assets inside are moved to the root
/// rather than deleted (see deleteFolder).
model MediaFolder {
  id        String   @id @default(cuid())
  name      String
  slug      String
  parentId  String?
  parent    MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("FolderTree")
  assets    MediaAsset[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Unique per level, not globally: "banners" may exist under two parents.
  @@unique([parentId, slug])
  @@index([parentId])
}

enum MediaKind {
  /// Mirrored from a WooCommerce product image.
  PRODUCT
  /// Uploaded through the admin media library.
  LIBRARY
}

model MediaAsset {
  id          String    @id @default(cuid())
  /// SHA-256 of the original bytes — the dedupe and idempotency key.
  contentHash String    @unique
  sourceUrl   String
  storageKey  String
  cdnUrl      String
  mimeType    String
  bytes       Int
  width       Int?
  height      Int?
  /// Generated derivative widths, e.g. [320, 640, 1280]
  derivatives Json?
  mirroredAt  DateTime?
  createdAt   DateTime  @default(now())

  kind     MediaKind    @default(PRODUCT)
  title    String?
  altText  String?
  folderId String?
  folder   MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  /// Names a fixed position on the storefront, e.g. "editorial-hero". Unique so
  /// a slot resolves to exactly one asset; null for ordinary library images.
  slot    String?   @unique

  products ProductImage[]

  @@index([sourceUrl])
  @@index([kind])
  @@index([folderId])
}

model ProductImage {
  productId String
  assetId   String
  position  Int     @default(0)
  alt       String?

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([productId, assetId])
  @@index([assetId])
}

model SyncLog {
  id         String        @id @default(cuid())
  target     String
  direction  SyncDirection
  outcome    SyncOutcome
  startedAt  DateTime
  finishedAt DateTime?
  created    Int           @default(0)
  updated    Int           @default(0)
  skipped    Int           @default(0)
  failed     Int           @default(0)
  error      String?

  @@index([target, startedAt])
}

// ── Storefront cart ──────────────────────────────────────
// Guest-only for now: the storefront has no customer accounts (User is
// staff-only, see spec §5.3). customerId is reserved so accounts can be added
// without a migration.

model Cart {
  id String @id @default(cuid())

  /// Opaque token held in the WOOMAKIS_CART cookie. Separate from the primary
  /// key so a leaked id cannot be replayed as a session.
  token String @unique @db.VarChar(64)

  customerId String?

  shippingMethod String? @db.VarChar(32)
  paymentMethod  String? @db.VarChar(32)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Touched on every read; drives abandoned-cart cleanup.
  lastSeenAt DateTime @default(now())

  lines CartLine[]

  @@index([lastSeenAt])
  @@index([customerId])
}

enum Eye {
  /// Δεξί, oculus dexter.
  RIGHT
  /// Αριστερό, oculus sinister.
  LEFT
  /// Non-optical items, or a product with no per-eye choice.
  BOTH
}

model CartLine {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Contact lenses are prescribed per eye and the two powers usually differ,
  /// so one product can legitimately appear twice in a cart.
  eye Eye @default(BOTH)

  /// The chosen attribute values, e.g. {"Ιδιότητα - Βαθμός": "-2.50"}.
  /// WooCommerce models power as a plain attribute, not a variation, so there
  /// is no variation id to store; this travels to the order as line-item meta.
  selections Json?

  /// Deterministic identity for "the same line": product + eye + selections.
  /// Unique per cart, which is what lets adding the same choice twice increment
  /// rather than create a second row, while a different power stays separate.
  lineKey String

  quantity Int @default(1)

  /// Price when the line was added. Kept for support questions ("it said 12 €
  /// yesterday") — never used for display or for computing the total, which
  /// always re-read the current catalogue price.
  addedPrice Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, lineKey])
  @@index([cartId])
  @@index([productId])
}

// ── Brands ───────────────────────────────────────────────
// WooCommerce exposes these at products/brands. Polylang duplicates them per
// language exactly like categories, so the same translation-group collapsing
// applies: 44 posts are ~22 real brands.

model Brand {
  id          String   @id @default(cuid())
  wooGroupKey Int      @unique
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  translations BrandTranslation[]
  products     ProductBrand[]
}

model BrandTranslation {
  brandId     String
  locale      String
  wooId       Int     @unique
  wooSnapshot Json?
  name        String
  slug        String
  description String?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([brandId, locale])
  @@index([slug])
}

model ProductBrand {
  productId String
  brandId   String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([productId, brandId])
  @@index([brandId])
}

// ── Customers ────────────────────────────────────────────
// Shaped after the damask Trdr model as agreed, keeping the SoftOne-style field
// names even though no SoftOne connector exists here: the user runs that stack
// elsewhere and wanted the naming to carry over.

enum CustomerSource {
  /// A registered WooCommerce customer account.
  WOO
  /// Derived from the billing block of a guest order.
  GUEST
  /// Created here, never seen upstream.
  LOCAL
}

model Customer {
  id     String @id @default(cuid())
  /// Null for guests and local records; unique when present.
  wooCustomerId Int? @unique
  source CustomerSource @default(WOO)

  /// 13 = πελάτης, 12 = προμηθευτής (SoftOne SODTYPE convention).
  SODTYPE Int     @default(13)
  CODE    String?
  NAME    String
  AFM     String?
  IRSDATA String?
  JOBTYPETRD String?
  ADDRESS String?
  ZIP     String?
  DISTRICT String?
  CITY    String?
  /// ISO-2 as WooCommerce sends it, e.g. "GR".
  COUNTRY String?
  PHONE01 String?
  EMAIL   String?
  WEBPAGE String?
  ISACTIVE Int    @default(1)
  REMARKS String?

  firstName String?
  lastName  String?
  company   String?

  /// Aggregated from orders, so the list can be sorted by value.
  orderCount Int      @default(0)
  totalSpent Decimal  @default(0) @db.Decimal(12, 2)
  lastOrderAt DateTime?

  wooSnapshot Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders  Order[]
  account CustomerAccount?

  @@index([source])
  @@index([EMAIL])
  @@index([NAME])
}

// ── Orders ───────────────────────────────────────────────
// Mirrored read-only from WooCommerce. Orders placed through this storefront
// are created upstream first (see lib/woo/orders.ts) and arrive back here on
// the next pull, so there is exactly one source of truth for an order and it
// is not this database.

model Order {
  id     String @id @default(cuid())
  wooId  Int    @unique
  /// Display number. Usually the id as a string, but plugins renumber, so it
  /// is stored rather than derived.
  number String
  status String

  currency      String   @default("EUR")
  total         Decimal  @db.Decimal(12, 2)
  totalTax      Decimal? @db.Decimal(12, 2)
  shippingTotal Decimal? @db.Decimal(12, 2)
  discountTotal Decimal? @db.Decimal(12, 2)

  paymentMethod      String?
  paymentMethodTitle String?
  transactionId      String?

  /// 0 upstream means a guest order; stored as null here.
  wooCustomerId Int?
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Denormalised from the billing block so the list renders without a join.
  billingName String
  email       String?
  phone       String?
  city        String?

  customerNote String?

  datePaid     DateTime?
  dateCreated  DateTime
  dateModified DateTime?

  wooSnapshot Json?
  syncedAt    DateTime @default(now())

  lines OrderLine[]

  @@index([status])
  @@index([dateCreated])
  @@index([customerId])
  @@index([email])
}

model OrderLine {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  wooLineId Int
  name      String
  sku       String?
  quantity  Int     @default(1)
  subtotal  Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  wooProductId   Int?
  wooVariationId Int?
  /// Null when the order references a product that is not in the local mirror
  /// — deleted upstream, or in a language group that was never pulled.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Line-item meta as WooCommerce stores it, which for this shop is the
  /// prescription: {"Βαθμός OD": "-2.50", "Καμπυλότητα OD": "8.60", …}.
  meta Json?

  @@unique([orderId, wooLineId])
  @@index([productId])
}

// ── Storefront content ───────────────────────────────────
// Pages and FAQ entries that exist only here. They are not mirrored from
// WooCommerce: the legal text belongs to this storefront, and keeping it in
// the database rather than in the code means it can be corrected without a
// deployment, which is what "εντός 30 ημερών" clauses eventually require.

enum ContentKind {
  TERMS
  PRIVACY
  COOKIES
  SHIPPING
  RETURNS
  GENERIC
}

model ContentPage {
  id        String      @id @default(cuid())
  /// URL segment, e.g. "oroi-chrisis". Shared across languages so a link keeps
  /// working when the visitor switches language.
  slug      String      @unique
  kind      ContentKind @default(GENERIC)
  published Boolean     @default(true)
  menuOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  translations ContentPageTranslation[]

  @@index([kind])
}

model ContentPageTranslation {
  pageId  String
  locale  String
  title   String
  /// Plain text with blank-line paragraphs and "## " headings. Deliberately
  /// not HTML: this is edited by staff, and accepting HTML from a textarea
  /// means accepting script injection into every visitor's page.
  body    String
  summary String?

  page ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([pageId, locale])
}

model FaqItem {
  id        String   @id @default(cuid())
  /// Free-text grouping, e.g. "Παραγγελίες", "Φακοί". Used as the section
  /// heading on the public page.
  category  String   @default("general")
  menuOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations FaqTranslation[]

  @@index([category, menuOrder])
}

model FaqTranslation {
  faqId    String
  locale   String
  question String
  answer   String
  /// The section heading in this language. Grouping still keys off
  /// FaqItem.category, which stays stable; this is the label shown for it.
  /// Null falls back to the item's own category, so a half-translated FAQ
  /// shows a Greek heading rather than no heading.
  category String?

  faq FaqItem @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@id([faqId, locale])
}

// ── Customer storefront accounts ─────────────────────────
// Separate from User, which is staff-only. A customer signing in here is not
// signing in to WooCommerce: WordPress password hashes cannot be verified
// through the REST API, so an existing customer sets a password here the first
// time and it is matched to their history by email.

model CustomerAccount {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  email        String  @unique
  passwordHash String
  active       Boolean @default(true)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ── Home page composition ────────────────────────────────
// Which sections appear on the storefront home page, in what order, and with
// what copy. Stored rather than hard-coded so the shop can reorder or retire a
// band without a deployment — the same reason the legal pages live in the
// database.

enum HomeSectionKind {
  HERO
  TRUST
  CATEGORIES
  PRODUCTS
  PANELS
  BRANDS
  NEWSLETTER
}

model HomeSection {
  id        String          @id @default(cuid())
  kind      HomeSectionKind @unique
  enabled   Boolean         @default(true)
  menuOrder Int             @default(0)

  /**
   * Which media slot supplies this section's image, when it uses one.
   * Names a MediaAsset.slot rather than an asset id, so re-assigning the slot
   * in the media library swaps the picture without touching this row.
   */
  imageSlot String?

  /** Second image, for the two-panel band. */
  imageSlotB String?

  /** How many items to show, where the section is a list. */
  itemLimit Int @default(6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations HomeSectionTranslation[]

  @@index([menuOrder])
}

model HomeSectionTranslation {
  sectionId String
  locale    String

  /** Small uppercase label above the heading. */
  eyebrow String?
  title   String?
  /** Supporting paragraph. */
  body    String?
  /** Primary call to action. */
  ctaLabel String?
  ctaHref  String?
  /** Second call to action, where the design has one. */
  ctaLabelB String?
  ctaHrefB  String?

  section HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([sectionId, locale])
}
